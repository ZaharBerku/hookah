    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "department": {
      "type": "text"
    },
    "phoneNumber": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Виконано",
        "Скасовано",
        "В обробці"
      ],
      "default": "В обробці"
